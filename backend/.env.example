# Copy to .env and adjust.
# Required (development | test | production); the app refuses to start without it.
NODE_ENV=development
PORT=3000

# PostgreSQL (docker compose up -d)
DATABASE_URL=postgresql://trello:trello@localhost:5432/trello?schema=public
TEST_DATABASE_URL=postgresql://trello:trello@localhost:5432/trello_test?schema=public

# Frontend origin allowed by CORS: one bare origin (no path, no list).
# Required in production (no localhost fallback there).
CORS_ORIGIN=http://localhost:5173

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Login/register attempts per IP per minute. Keep 10 in production;
# raise it locally (e.g. 1000) so repeated Playwright runs are not blocked.
AUTH_RATE_LIMIT_PER_MINUTE=10

# Public address of the frontend; invitation links are built from it.
# Required when NODE_ENV=production (the localhost default only applies in development/test).
APP_URL=http://localhost:5173

# Invitation create/preview/accept requests per IP per minute (per route).
# Raise it locally (e.g. 1000) so repeated Playwright runs are not blocked.
INVITATION_RATE_LIMIT_PER_MINUTE=30

# Default requests per IP per minute for routes without a stricter limit.
# Raise it locally (e.g. 1000) for heavy Playwright runs.
API_RATE_LIMIT_PER_MINUTE=300

# Reverse proxies in front of the app whose X-Forwarded-For hops are trusted (0-10).
# Keep 0 when the app is reached directly; set 1 behind a single proxy/load balancer so
# rate limiting sees the real client IP.
TRUST_PROXY=0
