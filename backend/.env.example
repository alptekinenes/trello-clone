# Copy to .env and adjust.
NODE_ENV=development
PORT=3000

# PostgreSQL (docker compose up -d)
DATABASE_URL=postgresql://trello:trello@localhost:5432/trello?schema=public
TEST_DATABASE_URL=postgresql://trello:trello@localhost:5432/trello_test?schema=public

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
